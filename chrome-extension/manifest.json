{
  "manifest_version": 3,
  "name": "GitHub Guide",
  "version": "0.1.0",
  "description": "Ask where things are on GitHub (\"make this repo public\") and get a link straight to the right setting. Bring your own Claude API key.",
  "permissions": ["storage"],
  "host_permissions": ["https://api.anthropic.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["catalog.js", "guide-core.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": { "default_title": "GitHub Guide" },
  "commands": {
    "toggle-panel": {
      "suggested_key": { "default": "Alt+Shift+G" },
      "description": "Open or close GitHub Guide"
    }
  }
}
